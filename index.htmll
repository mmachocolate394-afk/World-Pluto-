    <!-- CHATWAY WIDGET (Replace with your token) -->
    <script>
        (function(w,d,s,o,f,js,fjs){
            w['Chatway']=o;w[o]=w[o]||function(){(w[o].q=w[o].q||[]).push(arguments)};
            js=d.createElement(s),fjs=d.getElementsByTagName(s)[0];
            js.id=o;js.src=f;js.async=1;fjs.parentNode.insertBefore(js,fjs);
        }(window,document,'script','chatway','https://cdn.chatway.app/widget.js'));
        chatway('init', {
            token: 'YOUR_CHATWAY_TOKEN'  // <-- Replace with your actual token
        });
    </script>

    <!-- MAIN SCRIPT -->
    <script>
        // Starfield (unchanged)
        const canvas = document.getElementById('starfield');
        const ctx = canvas.getContext('2d');
        let stars = [];
        const starCount = 200;

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        function initStars() {
            stars = [];
            for (let i = 0; i < starCount; i++) {
                stars.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    radius: Math.random() * 1.5 + 0.5,
                    speed: Math.random() * 0.5 + 0.2,
                    opacity: Math.random() * 0.8 + 0.2,
                    twinkleSpeed: Math.random() * 0.02 + 0.005
                });
            }
        }
        initStars();

        function drawStars() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            stars.forEach(star => {
                star.y += star.speed;
                if (star.y > canvas.height) star.y = 0;
                star.opacity += Math.sin(Date.now() * star.twinkleSpeed) * 0.02;
                star.opacity = Math.max(0.1, Math.min(1, star.opacity));
                ctx.beginPath();
                ctx.arc(star.x, star.y, star.radius, 0, Math.PI * 2);
                ctx.fillStyle = `rgba(255, 255, 255, ${star.opacity})`;
                ctx.fill();
            });
            requestAnimationFrame(drawStars);
        }
        drawStars();

        // Page navigation
        function showPage(pageId) {
            document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
            const target = document.getElementById('page-' + pageId);
            if (target) target.classList.add('active');
            updateNavVisibility();
            window.scrollTo({ top: 0, behavior: 'smooth' });

            if (pageId === 'admin') {
                const adminLoggedIn = localStorage.getItem('wpAdminLoggedIn') === 'true';
                if (adminLoggedIn) {
                    showAdminDashboard();
                } else {
                    showAdminLoginForm();
                }
            }
        }

        function updateNavVisibility() {
            const isUserLoggedIn = localStorage.getItem('wpLoggedIn') === 'true';
            document.getElementById('navDashboardLink').style.display = isUserLoggedIn ? 'inline' : 'none';
            document.getElementById('navLogoutLink').style.display = isUserLoggedIn ? 'inline' : 'none';
        }

        // User functions
        function registerUser(userData) {
            const users = JSON.parse(localStorage.getItem('wpUsers') || '[]');
            if (users.some(u => u.username === userData.username)) {
                return { success: false, message: 'Username already exists.' };
            }
            if (users.some(u => u.email === userData.email)) {
                return { success: false, message: 'Email already registered.' };
            }
            userData.banned = false;
            users.push(userData);
            localStorage.setItem('wpUsers', JSON.stringify(users));
            return { success: true };
        }

        function authenticateUser(identifier, password) {
            const users = JSON.parse(localStorage.getItem('wpUsers') || '[]');
            const user = users.find(u => (u.username === identifier || u.email === identifier));
            if (!user) {
                return { success: false, message: 'User not found.' };
            }
            if (user.password !== password) {
                return { success: false, message: 'Incorrect password.' };
            }
            if (user.banned) {
                return { success: false, message: 'This account has been banned.' };
            }
            return { success: true, user: user };
        }

        function loginUser(user) {
            localStorage.setItem('wpLoggedIn', 'true');
            localStorage.setItem('wpCurrentUser', JSON.stringify(user));
            updateNavVisibility();
            showPage('dashboard');
            populateDashboard(user);
        }

        function logoutUser() {
            localStorage.removeItem('wpLoggedIn');
            localStorage.removeItem('wpCurrentUser');
            updateNavVisibility();
            showPage('login');
        }

        function populateDashboard(user) {
            document.getElementById('dashUsername').textContent = user.username;
            document.getElementById('dashEmail').textContent = user.email;
            document.getElementById('dashFirstName').textContent = user.firstName;
            document.getElementById('dashAvatar').textContent = user.firstName.charAt(0).toUpperCase();
            document.getElementById('profileName').value = user.firstName + ' ' + user.lastName;
            document.getElementById('profileEmail').value = user.email;
            document.getElementById('profilePhone').value = user.phone || '';
        }

        function handleRegister(event) {
            event.preventDefault();
            const alertBox = document.getElementById('registerAlert');
            const password = document.getElementById('regPassword').value;
            const confirm = document.getElementById('regConfirmPassword').value;
            if (password !== confirm) {
                alertBox.innerHTML = '<div class="alert alert-error">Passwords do not match.</div>';
                return;
            }
            const userData = {
                firstName: document.getElementById('regFirstName').value,
                lastName: document.getElementById('regLastName').value,
                email: document.getElementById('regEmail').value,
                username: document.getElementById('regUsername').value,
                phone: document.getElementById('regPhone').value,
                password: password,
                dob: document.getElementById('regDob').value,
                country: document.getElementById('regCountry').value,
                banned: false
            };
            const result = registerUser(userData);
            if (result.success) {
                alertBox.innerHTML = '<div class="alert alert-success">Registration successful! Please login.</div>';
                document.getElementById('registerForm').reset();
                setTimeout(() => showPage('login'), 1500);
            } else {
                alertBox.innerHTML = `<div class="alert alert-error">${result.message}</div>`;
            }
        }

        function handleLogin(event) {
            event.preventDefault();
            const alertBox = document.getElementById('loginAlert');
            const identifier = document.getElementById('loginUsername').value;
            const password = document.getElementById('loginPassword').value;
            const result = authenticateUser(identifier, password);
            if (result.success) {
                alertBox.innerHTML = '<div class="alert alert-success">Login successful! Redirecting...</div>';
                setTimeout(() => loginUser(result.user), 500);
            } else {
                alertBox.innerHTML = `<div class="alert alert-error">${result.message}</div>`;
            }
        }

        function handleAltLogin(event) {
            event.preventDefault();
            const alertBox = document.getElementById('altLoginAlert');
            const username = document.getElementById('altUsername').value;
            const password = document.getElementById('altPassword').value;
            const code = document.getElementById('altSecurityCode').value;
            if (code !== '123456') {
                alertBox.innerHTML = '<div class="alert alert-error">Invalid security code. Use 123456 for demo.</div>';
                return;
            }
            const result = authenticateUser(username, password);
            if (result.success) {
                alertBox.innerHTML = '<div class="alert alert-success">Access granted! Redirecting...</div>';
                setTimeout(() => loginUser(result.user), 500);
            } else {
                alertBox.innerHTML = `<div class="alert alert-error">${result.message}</div>`;
            }
        }

        function showDashboardSection(section) {
            const sections = ['overview', 'wallet', 'withdraw', 'transactions', 'profile'];
            sections.forEach(s => {
                document.getElementById('dash-' + s).style.display = s === section ? 'block' : 'none';
            });
            document.querySelectorAll('.sidebar .menu a').forEach(a => a.classList.remove('active'));
            const index = sections.indexOf(section);
            document.querySelectorAll('.sidebar .menu a')[index].classList.add('active');
        }

        function selectWithdrawal(method) {
            if (method === 'wallet') {
                document.getElementById('optWallet').classList.add('selected');
                document.getElementById('optBank').classList.remove('selected');
                document.getElementById('bankSelection').style.display = 'none';
            } else {
                document.getElementById('optBank').classList.add('selected');
                document.getElementById('optWallet').classList.remove('selected');
                document.getElementById('bankSelection').style.display = 'block';
                updateBankList();
            }
        }

        const banks = {
            USA: [
                { flag: '🇺🇸', name: 'Chase Bank', country: 'USA' },
                { flag: '🇺🇸', name: 'Bank of America', country: 'USA' },
                { flag: '🇺🇸', name: 'Wells Fargo', country: 'USA' },
                { flag: '🇺🇸', name: 'Citibank', country: 'USA' },
                { flag: '🇺🇸', name: 'Capital One', country: 'USA' },
            ],
            UK: [
                { flag: '🇬🇧', name: 'Barclays', country: 'UK' },
                { flag: '🇬🇧', name: 'HSBC', country: 'UK' },
                { flag: '🇬🇧', name: 'Lloyds Bank', country: 'UK' },
            ],
            CA: [
                { flag: '🇨🇦', name: 'Royal Bank of Canada', country: 'Canada' },
                { flag: '🇨🇦', name: 'TD Bank', country: 'Canada' },
            ],
            AU: [
                { flag: '🇦🇺', name: 'Commonwealth Bank', country: 'Australia' },
                { flag: '🇦🇺', name: 'Westpac', country: 'Australia' },
            ],
            DE: [
                { flag: '🇩🇪', name: 'Deutsche Bank', country: 'Germany' },
                { flag: '🇩🇪', name: 'Commerzbank', country: 'Germany' },
            ],
            FR: [
                { flag: '🇫🇷', name: 'BNP Paribas', country: 'France' },
                { flag: '🇫🇷', name: 'Société Générale', country: 'France' },
            ],
            ES: [
                { flag: '🇪🇸', name: 'Santander', country: 'Spain' },
                { flag: '🇪🇸', name: 'BBVA', country: 'Spain' },
            ],
            IT: [
                { flag: '🇮🇹', name: 'UniCredit', country: 'Italy' },
                { flag: '🇮🇹', name: 'Intesa Sanpaolo', country: 'Italy' },
            ],
            JP: [
                { flag: '🇯🇵', name: 'Mitsubishi UFJ', country: 'Japan' },
                { flag: '🇯🇵', name: 'Sumitomo Mitsui', country: 'Japan' },
            ],
            CN: [
                { flag: '🇨🇳', name: 'ICBC', country: 'China' },
                { flag: '🇨🇳', name: 'Bank of China', country: 'China' },
            ]
        };

        let selectedBank = null;

        function updateBankList() {
            const country = document.getElementById('withdrawCountry').value;
            const container = document.getElementById('bankListContainer');
            const bankList = banks[country] || [];
            container.innerHTML = '';
            bankList.forEach(bank => {
                const div = document.createElement('div');
                div.className = 'bank-item';
                div.innerHTML = `
                    <span class="bank-flag">${bank.flag}</span>
                    <div>
                        <div class="bank-name">${bank.name}</div>
                        <div class="bank-country">${bank.country}</div>
                    </div>
                `;
                div.onclick = function() {
                    document.querySelectorAll('.bank-item').forEach(i => i.classList.remove('selected'));
                    this.classList.add('selected');
                    selectedBank = bank;
                };
                container.appendChild(div);
            });
            selectedBank = null;
        }

        function simulateDeposit() {
            const amount = document.getElementById('depositAmount').value;
            if (!amount || amount <= 0) {
                alert('Please enter a valid deposit amount.');
                return;
            }
            alert(`Deposit of $${amount} simulated successfully.`);
            document.getElementById('depositAmount').value = '';
        }

        function simulateWithdrawal() {
            const amount = document.getElementById('withdrawAmount').value;
            if (!amount || amount <= 0) {
                document.getElementById('withdrawAlert').innerHTML = '<div class="alert alert-error">Please enter a valid amount.</div>';
                return;
            }
            const method = document.getElementById('optWallet').classList.contains('selected') ? 'Wallet' : 'Bank';
            if (method === 'Bank' && !selectedBank) {
                document.getElementById('withdrawAlert').innerHTML = '<div class="alert alert-error">Please select a bank.</div>';
                return;
            }
            const bankInfo = method === 'Bank' ? ` to ${selectedBank.name}` : '';
            document.getElementById('withdrawAlert').innerHTML = `<div class="alert alert-success">Withdrawal of $${amount} via ${method}${bankInfo} submitted. (Simulation)</div>`;
            document.getElementById('withdrawAmount').value = '';
        }

        // Admin functions
        function handleAdminLogin(event) {
            event.preventDefault();
            const username = document.getElementById('adminUsername').value;
            const password = document.getElementById('adminPassword').value;
            const alertBox = document.getElementById('adminLoginAlert');
            // CHANGE ADMIN PASSWORD HERE
            if (username === 'admin' && password === 'Pluto@2026!') {
                localStorage.setItem('wpAdminLoggedIn', 'true');
                updateNavVisibility();
                showAdminDashboard();
                alertBox.innerHTML = '<div class="alert alert-success">Admin login successful.</div>';
            } else {
                alertBox.innerHTML = '<div class="alert alert-error">Invalid admin credentials.</div>';
            }
        }

        function logoutAdmin() {
            localStorage.removeItem('wpAdminLoggedIn');
            updateNavVisibility();
            showAdminLoginForm();
            showPage('login');
        }

        function showAdminLoginForm() {
            document.getElementById('adminDashboard').style.display = 'none';
            document.querySelector('#page-admin .card:first-child').style.display = 'block';
        }

        function showAdminDashboard() {
            document.querySelector('#page-admin .card:first-child').style.display = 'none';
            document.getElementById('adminDashboard').style.display = 'block';
            renderAdminUserTable();
        }

        function renderAdminUserTable() {
            const users = JSON.parse(localStorage.getItem('wpUsers') || '[]');
            const tbody = document.getElementById('adminUserTableBody');
            tbody.innerHTML = '';
            if (users.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted">No registered users yet.</td></tr>';
                return;
            }
            users.forEach((user, index) => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>${user.username}</td>
                    <td>${user.firstName} ${user.lastName}</td>
                    <td>${user.email}</td>
                    <td>${user.country || 'N/A'}</td>
                    <td>${user.banned ? '<span class="badge badge-failed">Banned</span>' : '<span class="badge badge-success">Active</span>'}</td>
                    <td class="admin-actions">
                        ${user.banned ? 
                            `<button class="btn-unban" onclick="toggleBan(${index}, false)">Unban</button>` : 
                            `<button class="btn-ban" onclick="toggleBan(${index}, true)">Ban</button>`}
                        <button class="btn-delete" onclick="deleteUser(${index})">Delete</button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function deleteUser(index) {
            if (!confirm('Are you sure you want to delete this user?')) return;
            let users = JSON.parse(localStorage.getItem('wpUsers') || '[]');
            users.splice(index, 1);
            localStorage.setItem('wpUsers', JSON.stringify(users));
            renderAdminUserTable();
            document.getElementById('adminAlert').innerHTML = '<div class="alert alert-success">User deleted.</div>';
        }

        function toggleBan(index, banStatus) {
            let users = JSON.parse(localStorage.getItem('wpUsers') || '[]');
            if (index >= 0 && index < users.length) {
                users[index].banned = banStatus;
                localStorage.setItem('wpUsers', JSON.stringify(users));
                renderAdminUserTable();
                document.getElementById('adminAlert').innerHTML = `<div class="alert alert-info">User ${banStatus ? 'banned' : 'unbanned'}.</div>`;
            }
        }

        window.addEventListener('DOMContentLoaded', () => {
            if (localStorage.getItem('wpLoggedIn') === 'true') {
                const user = JSON.parse(localStorage.getItem('wpCurrentUser') || '{}');
                if (user.username) {
                    populateDashboard(user);
                    showPage('dashboard');
                }
            }
            updateNavVisibility();
        });
    </script>
</body>
</html>